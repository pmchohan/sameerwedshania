[Unit]
Description=NestJS Wedding Invitation API with Cloudflare Tunnel
After=network.target mysql.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/wedding-api
ExecStart=/bin/bash /home/ubuntu/wedding-api/start-with-tunnel.sh
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
